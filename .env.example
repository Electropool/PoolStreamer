# ============================================
# PoolStreamer — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Discord ──────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_application_client_id
OWNER_ID=your_discord_user_id

# ── MongoDB ──────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/poolstreamer
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/poolstreamer

# ── Lavalink ─────────────────────────────────
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false

# ── Bot Config ───────────────────────────────
BOT_PREFIX=!
DEFAULT_VOLUME=80
MAX_QUEUE_SIZE=500
MAX_SONG_DURATION=10800
# Node environment (development | production)
NODE_ENV=production

# ── Health Check Server ──────────────────────
PORT=3000

# ── Logging ──────────────────────────────────
LOG_LEVEL=info
# LOG_LEVEL options: error | warn | info | debug
